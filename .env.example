# RollMetrics runtime configuration (.env.example)
# Copy to .env for local overrides. Never commit real secrets to git.

# Server & deployment environment (local | cloud | test)
ROLLMETRICS_APP_NAME=RollMetrics
ROLLMETRICS_PUBLIC_URL=http://127.0.0.1:8090
ROLLMETRICS_ENVIRONMENT=local
ROLLMETRICS_HOST=0.0.0.0
PORT=8090

# Google Sign-In allowlist authentication
ROLLMETRICS_GOOGLE_CLIENT_ID=
ROLLMETRICS_FIREBASE_PROJECT_ID=
ROLLMETRICS_ALLOWLIST_EMAILS=
ROLLMETRICS_OWNER_EMAIL=
ROLLMETRICS_ALLOW_OPEN_SIGNUP=false
ROLLMETRICS_ALLOW_LOCAL_DEV_BYPASS=true
ROLLMETRICS_DEFAULT_ACADEMY_ID=osjj-roadmap

# Vision & referee model profile ('local' default for Apple Silicon Ollama; set 'cloud' in Cloud Run)
ROLLMETRICS_PROFILE=local
GEMINI_API_KEY=
ROLLMETRICS_GEMINI_API_KEY=
ROLLMETRICS_TRACKER_MODEL=gemini-4-hydrogen
ROLLMETRICS_ADJUDICATOR_MODEL=gemini-4-neon
ROLLMETRICS_EMBEDDING_MODEL=gemini-embedding-2
ROLLMETRICS_GEMMA_API_MODEL=gemma-4-26b-a4b-it

# Local Apple Silicon Ollama runtime (16GB RAM friendly GGUF vision + JSON defaults)
ROLLMETRICS_OLLAMA_BASE_URL=http://127.0.0.1:11434
ROLLMETRICS_OLLAMA_VISION_MODEL=gemma4:e2b-it-q4_K_M
ROLLMETRICS_OLLAMA_TEXT_MODEL=gemma4:e2b-it-q4_K_M

# Storage & versioned knowledge index
ROLLMETRICS_ACTIVE_INDEX_VERSION=v0.1.0
ROLLMETRICS_GCS_BUCKET=
